load ../src/workflow.maude

fmod RQ-CASE-LIBRARY is
  pr MBQC-WORKFLOW .

  ------------------------------------------------------------
  --- Symbolic simplifications used by concrete-state tests
  ------------------------------------------------------------

  eq sqrt(4)   = 2 .
  eq sqrt(16)  = 4 .
  eq sqrt(64)  = 8 .
  eq sqrt(256) = 16 .


  --- ============================================================
  --- Baselines and specifications
  --- ============================================================


  ------------------------------------------------------------
  --- Teleportation-style identity on |0>
  ------------------------------------------------------------

  op Tele0BaseP : -> Pattern .
  op Tele0Spec  : -> Vect .

  eq Tele0BaseP =
    < 0 1 2,
      < 0 @ |0> >,
      2,

      X(2, [zero, 1])
      Z(2, [zero, 0])

      M(1, '0pi, [zero, 0], zeroS)
      M(0, '0pi, zeroS, zeroS)

      E(< 1,2 >)
      E(< 0,1 >)
    >
  .

  eq Tele0Spec = |0> .


  ------------------------------------------------------------
  --- Teleportation-style identity on |+>
  ------------------------------------------------------------

  op TelePlusBaseP : -> Pattern .
  op TelePlusSpec  : -> Vect .

  eq TelePlusBaseP =
    < 0 1 2,
      < 0 @ |+> >,
      2,

      X(2, [zero, 1])
      Z(2, [zero, 0])

      M(1, '0pi, [zero, 0], zeroS)
      M(0, '0pi, zeroS, zeroS)

      E(< 1,2 >)
      E(< 0,1 >)
    >
  .

  eq TelePlusSpec = |+> .


  ------------------------------------------------------------
  --- CNOT baseline for X-side mutations
  ------------------------------------------------------------

  op CNOTXBaseP : -> Pattern .
  op CNOTXSpec  : -> Vect .

  eq CNOTXBaseP =
    < 0 1 2 3,
      < 0 @ |0> >
      < 1 @ |0> >,
      0 3,

      X(3, [zero, 2])
      Z(3, [zero, 1])
      Z(0, [zero, 1])

      M(2, '0pi, [zero, 1], zeroS)
      M(1, '0pi, zeroS, zeroS)

      E(< 2,3 >)
      E(< 0,2 >)
      E(< 1,2 >)
    >
  .

  eq CNOTXSpec = |0> (x) |0> .


  ------------------------------------------------------------
  --- CNOT baseline for Z-side mutations
  ------------------------------------------------------------

  op CNOTZBaseP : -> Pattern .
  op CNOTZSpec  : -> Vect .

  eq CNOTZBaseP =
    < 0 1 2 3,
      < 0 @ |+> >
      < 1 @ |+> >,
      0 3,

      X(3, [zero, 2])
      Z(3, [zero, 1])
      Z(0, [zero, 1])

      M(2, '0pi, [zero, 1], zeroS)
      M(1, '0pi, zeroS, zeroS)

      E(< 2,3 >)
      E(< 0,2 >)
      E(< 1,2 >)
    >
  .

  eq CNOTZSpec = |+> (x) |+> .


  ------------------------------------------------------------
  --- Baseline for observable Z-constant mutation
  ------------------------------------------------------------

  op ZConstBaseP : -> Pattern .
  op ZConstSpec  : -> Vect .

  eq ZConstBaseP =
    < 0 1 2,
      nil,
      1 2,

      Z(2, [zero, 0])
      X(1, [zero, 0])

      M(0, '0pi, zeroS, zeroS)

      E(< 0,1 > < 1,2 >)
    >
  .

  eq ZConstSpec = |0> (x) |+> .


  ------------------------------------------------------------
  --- Baseline for measurement-angle mutation
  ------------------------------------------------------------

  op AngleBaseP : -> Pattern .
  op AngleSpec  : -> Vect .

  eq AngleBaseP =
    < 0 1,
      < 0 @ |+> >,
      1,

      X(1, [zero, 0])

      M(0, '-pi, zeroS, zeroS)

      E(< 0,1 >)
    >
  .

  eq AngleSpec = |1> .


  --- ============================================================
  --- A. Well-formedness faults
  --- ============================================================


  ------------------------------------------------------------
  --- WF-1: duplicate vertex
  ------------------------------------------------------------

  op WF1DuplicateVertexP : -> Pattern .

  eq WF1DuplicateVertexP =
    < 0 1 1 2,
      < 0 @ |0> >,
      2,

      X(2, [zero, 1])
      Z(2, [zero, 0])

      M(1, '0pi, [zero, 0], zeroS)
      M(0, '0pi, zeroS, zeroS)

      E(< 1,2 >)
      E(< 0,1 >)
    >
  .


  ------------------------------------------------------------
  --- WF-2: output outside V
  ------------------------------------------------------------

  op WF2InvalidOutputP : -> Pattern .

  eq WF2InvalidOutputP =
    < 0 1 2,
      < 0 @ |0> >,
      3,

      X(2, [zero, 1])
      Z(2, [zero, 0])

      M(1, '0pi, [zero, 0], zeroS)
      M(0, '0pi, zeroS, zeroS)

      E(< 1,2 >)
      E(< 0,1 >)
    >
  .


  ------------------------------------------------------------
  --- WF-3: missing measurement
  ------------------------------------------------------------

  op WF3MissingMeasurementP : -> Pattern .

  eq WF3MissingMeasurementP =
    < 0 1 2,
      < 0 @ |0> >,
      2,

      Z(2, [zero, 0])

      M(0, '0pi, zeroS, zeroS)

      E(< 1,2 >)
      E(< 0,1 >)
    >
  .


  ------------------------------------------------------------
  --- WF-4: unavailable dependency
  ------------------------------------------------------------

  op WF4UnavailableDependencyP : -> Pattern .

  eq WF4UnavailableDependencyP =
    < 0 1 2,
      < 0 @ |0> >,
      2,

      X(2, [zero, 1])
      Z(2, [zero, 0])

      M(1, '0pi, [zero, 0], zeroS)
      M(0, '0pi, [zero, 2], zeroS)

      E(< 1,2 >)
      E(< 0,1 >)
    >
  .


  ------------------------------------------------------------
  --- WF-5: correction targets a measured qubit
  ------------------------------------------------------------

  op WF5PastCorrectionP : -> Pattern .

  eq WF5PastCorrectionP =
    < 0 1 2,
      < 0 @ |0> >,
      2,

      X(0, [zero, 1])
      X(2, [zero, 1])
      Z(2, [zero, 0])

      M(1, '0pi, [zero, 0], zeroS)
      M(0, '0pi, zeroS, zeroS)

      E(< 1,2 >)
      E(< 0,1 >)
    >
  .


  ------------------------------------------------------------
  --- WF-6: duplicate input assignment
  ------------------------------------------------------------

  op WF6DuplicateInputP : -> Pattern .

  eq WF6DuplicateInputP =
    < 0 1 2,
      < 0 @ |0> >
      < 0 @ |0> >,
      2,

      X(2, [zero, 1])
      Z(2, [zero, 0])

      M(1, '0pi, [zero, 0], zeroS)
      M(0, '0pi, zeroS, zeroS)

      E(< 1,2 >)
      E(< 0,1 >)
    >
  .


  --- ============================================================
  --- B. Command-form faults
  --- ============================================================


  ------------------------------------------------------------
  --- CMD-1: residual t-signal
  ------------------------------------------------------------

  op CMD1ResidualTP : -> Pattern .

  eq CMD1ResidualTP =
    < 0 1 2,
      < 0 @ |0> >,
      2,

      X(2, [zero, 1])
      Z(2, [zero, 0])

      M(1, '0pi, [zero, 0], [zero, 0 0])
      M(0, '0pi, zeroS, zeroS)

      E(< 1,2 >)
      E(< 0,1 >)
    >
  .


  ------------------------------------------------------------
  --- CMD-2: command-phase order violation
  ------------------------------------------------------------

  op CMD2OrderP : -> Pattern .

  eq CMD2OrderP =
    < 0 1 2,
      < 0 @ |0> >,
      2,

      X(2, [zero, 1])

      M(1, '0pi, [zero, 0], zeroS)

      Z(2, [zero, 0])

      M(0, '0pi, zeroS, zeroS)

      E(< 1,2 >)
      E(< 0,1 >)
    >
  .


  --- ============================================================
  --- C. Constant-related cases
  --- ============================================================


  ------------------------------------------------------------
  --- C-1: observable Z-constant fault
  ------------------------------------------------------------

  op ZConstMutP : -> Pattern .

  eq ZConstMutP =
    < 0 1 2,
      nil,
      1 2,

      Z(2, [one, 0])
      X(1, [zero, 0])

      M(0, '0pi, zeroS, zeroS)

      E(< 0,1 > < 1,2 >)
    >
  .


  ------------------------------------------------------------
  --- C-2: harmless zero-angle measurement constant
  ------------------------------------------------------------

  op MConstP : -> Pattern .

  eq MConstP =
    < 0 1 2,
      < 0 @ |0> >,
      2,

      X(2, [zero, 1])
      Z(2, [zero, 0])

      M(1, '0pi, [one, 0], zeroS)
      M(0, '0pi, zeroS, zeroS)

      E(< 1,2 >)
      E(< 0,1 >)
    >
  .


  --- ============================================================
  --- D. Realized-gflow / correction faults
  --- ============================================================


  ------------------------------------------------------------
  --- D-1: delete X correction
  ------------------------------------------------------------

  op XDelP : -> Pattern .

  eq XDelP =
    < 0 1 2 3,
      < 0 @ |0> >
      < 1 @ |0> >,
      0 3,

      Z(3, [zero, 1])
      Z(0, [zero, 1])

      M(2, '0pi, [zero, 1], zeroS)
      M(1, '0pi, zeroS, zeroS)

      E(< 2,3 >)
      E(< 0,2 >)
      E(< 1,2 >)
    >
  .


  ------------------------------------------------------------
  --- D-2: retarget X correction
  ------------------------------------------------------------

  op XTgtP : -> Pattern .

  eq XTgtP =
    < 0 1 2 3,
      < 0 @ |0> >
      < 1 @ |0> >,
      0 3,

      X(0, [zero, 2])
      Z(3, [zero, 1])
      Z(0, [zero, 1])

      M(2, '0pi, [zero, 1], zeroS)
      M(1, '0pi, zeroS, zeroS)

      E(< 2,3 >)
      E(< 0,2 >)
      E(< 1,2 >)
    >
  .


  ------------------------------------------------------------
  --- D-3: change X dependency
  ------------------------------------------------------------

  op XDepP : -> Pattern .

  eq XDepP =
    < 0 1 2 3,
      < 0 @ |0> >
      < 1 @ |0> >,
      0 3,

      X(3, [zero, 1])
      Z(3, [zero, 1])
      Z(0, [zero, 1])

      M(2, '0pi, [zero, 1], zeroS)
      M(1, '0pi, zeroS, zeroS)

      E(< 2,3 >)
      E(< 0,2 >)
      E(< 1,2 >)
    >
  .


  ------------------------------------------------------------
  --- D-4: delete Z correction
  ------------------------------------------------------------

  op ZDelP : -> Pattern .

  eq ZDelP =
    < 0 1 2 3,
      < 0 @ |+> >
      < 1 @ |+> >,
      0 3,

      X(3, [zero, 2])
      Z(3, [zero, 1])

      M(2, '0pi, [zero, 1], zeroS)
      M(1, '0pi, zeroS, zeroS)

      E(< 2,3 >)
      E(< 0,2 >)
      E(< 1,2 >)
    >
  .


  ------------------------------------------------------------
  --- D-5: change Z dependency
  ------------------------------------------------------------

  op ZDepP : -> Pattern .

  eq ZDepP =
    < 0 1 2 3,
      < 0 @ |+> >
      < 1 @ |+> >,
      0 3,

      X(3, [zero, 2])
      Z(3, [zero, 1])
      Z(0, [zero, 2])

      M(2, '0pi, [zero, 1], zeroS)
      M(1, '0pi, zeroS, zeroS)

      E(< 2,3 >)
      E(< 0,2 >)
      E(< 1,2 >)
    >
  .


  ------------------------------------------------------------
  --- D-6: delete measurement s-dependency
  ------------------------------------------------------------

  op MSDelP : -> Pattern .

  eq MSDelP =
    < 0 1 2 3,
      < 0 @ |0> >
      < 1 @ |0> >,
      0 3,

      X(3, [zero, 2])
      Z(3, [zero, 1])
      Z(0, [zero, 1])

      M(2, '0pi, zeroS, zeroS)
      M(1, '0pi, zeroS, zeroS)

      E(< 2,3 >)
      E(< 0,2 >)
      E(< 1,2 >)
    >
  .


  --- ============================================================
  --- E. Entanglement faults
  --- ============================================================


  ------------------------------------------------------------
  --- E-1: delete edge
  ------------------------------------------------------------

  op EDelP : -> Pattern .

  eq EDelP =
    < 0 1 2,
      < 0 @ |0> >,
      2,

      X(2, [zero, 1])
      Z(2, [zero, 0])

      M(1, '0pi, [zero, 0], zeroS)
      M(0, '0pi, zeroS, zeroS)

      E(< 0,1 >)
    >
  .


  ------------------------------------------------------------
  --- E-2: change edge target
  ------------------------------------------------------------

  op ETgtP : -> Pattern .

  eq ETgtP =
    < 0 1 2,
      < 0 @ |0> >,
      2,

      X(2, [zero, 1])
      Z(2, [zero, 0])

      M(1, '0pi, [zero, 0], zeroS)
      M(0, '0pi, zeroS, zeroS)

      E(< 0,2 >)
      E(< 0,1 >)
    >
  .


  ------------------------------------------------------------
  --- E-3: add a new edge
  ------------------------------------------------------------

  op EAddNewP : -> Pattern .

  eq EAddNewP =
    < 0 1 2,
      < 0 @ |+> >,
      2,

      X(2, [zero, 1])
      Z(2, [zero, 0])

      M(1, '0pi, [zero, 0], zeroS)
      M(0, '0pi, zeroS, zeroS)

      E(< 0,2 >)
      E(< 1,2 >)
      E(< 0,1 >)
    >
  .


  --- ============================================================
  --- F. Functional fault
  --- ============================================================


  ------------------------------------------------------------
  --- F-1: measurement-angle mutation
  ------------------------------------------------------------

  op AngleMutP : -> Pattern .

  eq AngleMutP =
    < 0 1,
      < 0 @ |+> >,
      1,

      X(1, [zero, 0])

      M(0, '0pi, zeroS, zeroS)

      E(< 0,1 >)
    >
  .


  --- ============================================================
  --- G. Semantic-equivalence controls
  --- ============================================================


  ------------------------------------------------------------
  --- G-1: parity-equivalent measurement dependency
  ------------------------------------------------------------

  op MSDupParityP : -> Pattern .

  eq MSDupParityP =
    < 0 1 2 3,
      < 0 @ |0> >
      < 1 @ |0> >,
      0 3,

      X(3, [zero, 2])
      Z(3, [zero, 1])
      Z(0, [zero, 1])

      M(2, '0pi, [zero, 1 1 1], zeroS)
      M(1, '0pi, zeroS, zeroS)

      E(< 2,3 >)
      E(< 0,2 >)
      E(< 1,2 >)
    >
  .


  ------------------------------------------------------------
  --- G-2: three equal CZ edges have odd parity
  ------------------------------------------------------------

  op ETripleParityP : -> Pattern .

  eq ETripleParityP =
    < 0 1 2,
      < 0 @ |0> >,
      2,

      X(2, [zero, 1])
      Z(2, [zero, 0])

      M(1, '0pi, [zero, 0], zeroS)
      M(0, '0pi, zeroS, zeroS)

      E(< 1,2 >)
      E(< 1,2 >)
      E(< 1,2 >)
      E(< 0,1 >)
    >
  .

endfm