load standardize.maude

view Ang from TRIV to MBQC-MEAS is
  sort Elt to Ang .
endv


fmod GATE is
    pr MBQC-LANG .

    sort Gate .
    op J : Ang Nat -> Gate .
    op CZG : Nat Nat -> Gate .
endfm

view Gate from TRIV to GATE is
    sort Elt to Gate .
endv

    ------------------------------------------------------------
    --- Circuit-to-pattern compiler
    ------------------------------------------------------------
fmod COMPILE-WIRE is
    pr SIGNAL-SHIFTING .
    pr LIST{Gate} .
    pr MAP{Nat,Nat} .
    pr GATE .

    sort CState .
    
    op <_,_,_> : Map{Nat, Nat} Nat List{Command} -> CState .
    
    vars W W1 W2 W3 N N1 N2 Next : Nat .
    var M : Map{Nat, Nat} .
    var A : Ang .
    var G G1 G2 : Gate .
    var LG LG1 : List{Gate} .
    var CS : CState .
    var LC : List{Command} .
    var LNV : List{PairNV} .

    op curOf : Nat Map{Nat, Nat} -> Nat .
    ceq curOf(W, M) = M[W] if M[W] =/= undefined .
    eq curOf(W, M) = errNat [owise] .

    --- Initialize each logical wire to its initial qubit.
    op initCurFrom : Nat Nat -> Map{Nat, Nat} .
    ceq initCurFrom(N1, N2) = empty if N2 >= N1 .
    ceq initCurFrom(N1, N2) = insert(N2, N2, initCurFrom(N1, s(N2))) if N2 < N1 .

    op initCur : Nat -> Map{Nat, Nat} .
    eq initCur(N) = initCurFrom(N, 0) .

    op range0 : Nat -> List{Nat} .
    eq range0(0) = nil .
    eq range0(s(N)) = range0(N) N .

    --- Build O in logical-wire order: [cur[0], ..., cur[W-1]].
    op outsFrom : Nat Nat Map{Nat, Nat} -> List{Nat} .
    ceq outsFrom(N1, N2, M) = nil if N2 >= N1 .
    ceq outsFrom(N1, N2, M) = curOf(N2, M) outsFrom(N1, s(N2), M) if N2 < N1 .


    op outs : Nat Map{Nat, Nat} -> List{Nat} .
    eq outs(N1, M) = outsFrom(N1, 0, M) .

    --- Initial state: current wire heads, next fresh qubit N, and no commands.
    op initSt : Nat -> CState .
    eq initSt(N) = < initCur(N), N, nil > .

    op step : Gate CState -> CState .

    ceq step(J(A, N), < M, N1, LC >)
        = < insert(N, N1, M),
            s(N1),
            X(N1, [zero, curOf(N, M)])
            M(curOf(N, M), neg(A), [zero, nil], [zero, nil])
            E(< curOf(N, M), N1 >)
            LC > if curOf(N, M) =/= errNat .

    --- CZG entangles the current head qubits of the two logical wires.
    ceq step(CZG(N1, N2), < M, N, LC >)
    = < M, N,
        E(< curOf(N1, M), curOf(N2, M) >)
        LC > 
        if curOf(N1, M) =/= errNat /\ curOf(N2, M) =/= errNat .

    --- Compile gates from left to right.
    op comp : List{Gate} CState -> CState .

    eq comp(nil, CS) = CS .
    eq comp(G LG, CS) = comp(LG, step(G, CS)) .

    op st : Nat List{Gate} -> CState .
    eq st(N, LG) = comp(LG, initSt(N)) .

    op getM  : CState -> Map{Nat, Nat} .
    op nextN : CState -> Nat .
    op getLC : CState -> List{Command} .

    eq getM(< M, N, LC >) = M .
    eq nextN(< M, N, LC >) = N .
    eq getLC(< M, N, LC >) = LC .
    
    --- Assemble <V, In, O, LC> from the compiled state.
    op compile : Nat List{Gate} List{PairNV} -> Pattern .

    eq compile(N, LG, LNV)
        = < range0(nextN(st(N, LG))), LNV,
            outs(N, getM(st(N, LG))),
            getLC(st(N, LG)) > .
        


endfm 

