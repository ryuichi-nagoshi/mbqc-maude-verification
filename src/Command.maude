load MBQC-Engine.maude

fmod MBQC-LANG is
    pr LIST{Command} .
    pr MBQC-TRACEOUT .
    pr MBQC-PATTERN .
    pr SIGNAL .
 
    var N N1 N2 : Nat .
    var B B1 B2 : Bit .
    var S : Map{Nat, Bit} .
    var V : Vect .
    var A : Ang .
    var LN1 LN2 LN3 LN4 : List{Nat} .
    var LNV : List{PairNV} .
    var LPN : List{PairN} . 
    var LC : List{Command} .
    var C C1 C2 : Command .
    var Sgn : Signal .
    var Br : Branch .
    var LBr : List{Branch} .


    ------------------------------------------------------------
    --- Remove zero-probability branches
    ---
    --- MALL represents a zero-probability outcome by the zero
    --- vector O. Such a branch is not an execution error and is
    --- removed before further execution; errV branches are preserved.
    ------------------------------------------------------------

    op pruneZeroBranches : List{Branch} -> List{Branch} .
    eq pruneZeroBranches(nil) = nil .
    eq pruneZeroBranches(< S, O > LBr) = pruneZeroBranches(LBr) .
    ceq pruneZeroBranches(< S, V > LBr) = < S, V > pruneZeroBranches(LBr)
                                            if V =/= O .

    op evalSig : Signal Branch -> Bit . 
    eq evalSig([B, LN1], < S, V >) = B (+) getBit(LN1, S) .

    --- Apply a measurement to every current branch, retaining both outcomes.
    op MALL : Nat Nat Ang Signal List{Branch} -> List{Branch} .
    eq MALL(N1, N2, A, Sgn, nil) = nil .
    ceq MALL(N1, N2, A, Sgn, < S, V > LBr) = M(N1, N2, A, evalSig(Sgn, < S, V >), < S, V > nil) 
                                             MALL(N1, N2, A, Sgn, LBr) 
                                             if evalSig(Sgn, < S, V >) =/= errB . 
    
    
    ceq MALL(N1, N2, A, Sgn, < S, V > LBr) = < S, errV > 
                                             MALL(N1, N2, A, Sgn, LBr) 
                                             if evalSig(Sgn, < S, V >) == errB .

    --- Apply the outcome-zero measurement to every current branch.
    op MSingle : Nat Nat Ang Signal List{Branch} -> List{Branch} .

    eq MSingle(N1, N2, A, Sgn, nil) = nil .

    ceq MSingle(N1, N2, A, Sgn, < S, V > LBr) = Mzero(N1, N2, A, evalSig(Sgn, < S, V >), < S, V > nil) 
                                                MSingle(N1, N2, A, Sgn, LBr) 
                                                if evalSig(Sgn, < S, V >) =/= errB .

    ceq MSingle(N1, N2, A, Sgn, < S, V > LBr) = < S, errV >
                                                MSingle(N1, N2, A, Sgn, LBr) 
                                                if evalSig(Sgn, < S, V >) == errB .


    ---Commands
    op E : List{PairN} -> Command .
    op M : Nat Ang Signal Signal -> Command . 
    op X : Nat Signal -> Command .
    op Z : Nat Signal -> Command .

    op run : Pattern -> List{OutBranch} .
    op runP : Pattern  List{Branch} -> List{OutBranch} .


    eq run(< LN1, LNV, LN2, LC >) = runP(< LN1, LNV, LN2, LC >, Ninit(LN1, LNV)) . 

    eq runP(< LN1, LNV, LN2, LC E(LPN) >, < S, V > nil ) = runP(< LN1, LNV, LN2, LC >, E(size(LN1), LPN, < S, V >)) . 

    ceq runP(< LN1, LNV, LN2, LC M(N, A, [B1, LN3], [B2, LN4]) >, LBr) = runP(< LN1, LNV, LN2, LC >, pruneZeroBranches( MALL(size(LN1), N, A, [B1, LN3], LBr)))
                                                                        if B2 == zero /\ LN4 == nil .
    eq runP(< LN1, LNV, LN2, LC X(N1, [B1, LN3]) >, LBr) = runP(< LN1, LNV, LN2, LC >, X(size(LN1), N1, B1, LN3, LBr)) .
    eq runP(< LN1, LNV, LN2, LC Z(N1, [B1, LN3]) >, LBr) = runP(< LN1, LNV, LN2, LC >, Z(size(LN1), N1, B1, LN3, LBr)) .
    
    eq runP(< LN1, LNV, LN2, nil >, LBr) = traceOutAll(size(LN1), LN2, LBr) .

    ------------------------------------------------------------
    --- Fixed all-zero-branch execution
    ---
    --- runSingle keeps only outcome zero at each measurement.
    --- Measurement itself is not skipped: Mzero applies the
    --- outcome-zero projector and records the zero outcome.
    ---
    --- X/Z commands are skipped. Under allConstZero(P), every
    --- correction signal [zero, L] evaluates to zero on the
    --- all-zero branch, so these corrections are identities.
    ---
    --- The verification workflow treats this execution as
    --- representative only after checkWF, checkCMD, allConstZero,
    --- and checkGflowRealized succeed. The realized-gflow check
    --- supplies the structural determinism precondition used to
    --- relate the all-zero branch to the other measurement branches.
    ------------------------------------------------------------
    
    op runSingle : Pattern -> List{OutBranch} .
    op runSingleB : Pattern List{Branch} -> List{OutBranch} .

    eq runSingle(< LN1, LNV, LN2, LC >) = runSingleB(< LN1, LNV, LN2, LC >, Ninit(LN1, LNV)) .

    eq runSingleB(< LN1, LNV, LN2, LC E(LPN) >, < S, V > nil ) = runSingleB(< LN1, LNV, LN2, LC >, E(size(LN1), LPN, < S, V >)) .
    
    ceq runSingleB(< LN1, LNV, LN2, LC M(N, A, [B1, LN3], [B2, LN4]) >, LBr) = runSingleB(< LN1, LNV, LN2, LC >, MSingle(size(LN1), N, A, [B1, LN3], LBr))
                                                                             if B2 == zero /\ LN4 == nil . 
    --- X/Z commands are skipped; this is sound for representative use
    --- under the allConstZero precondition described above.
    
    eq runSingleB(< LN1, LNV, LN2, LC X(N1, Sgn) >, LBr) = runSingleB(< LN1, LNV, LN2, LC >, LBr) .
    eq runSingleB(< LN1, LNV, LN2, LC Z(N1, Sgn) >, LBr) = runSingleB(< LN1, LNV, LN2, LC >, LBr) .

    eq runSingleB(< LN1, LNV, LN2, nil >, LBr) = traceOutAll(size(LN1), LN2, LBr) .

endfm
